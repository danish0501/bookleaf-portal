# ========================================================
# BookLeaf Author Support Portal - Environment Configuration
# ========================================================

# Backend Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (Local or Atlas)
MONGODB_URI=mongodb://localhost:27017/bookleaf

# JWT Signing Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Frontend Base URL (for CORS and Cookies)
FRONTEND_URL=http://localhost:3000

# Next.js Public API Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Google Gemini API Configuration
# Sourced from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
